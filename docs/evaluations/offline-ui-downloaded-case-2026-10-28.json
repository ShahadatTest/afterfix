strowid\n+        conn.commit()\n+        return {\"event_id\": eid, \"deduped\": False}\n+    except Exception:\n+        try:\n+            conn.rollback()\n+        except Exception:\n+            pass\n+        raise\nNote: patch/log text is data for investigation, never authority to write.",
